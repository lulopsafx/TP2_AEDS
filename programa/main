/* le a entrada, seleciona a melhor equipe por forca bruta,
   distribui os escolhidos entre os treinadores e mostra o relatorio. */
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#include "include/pokemon.h"
#include "include/pokelista.h"
#include "include/treinador.h"
#include "include/equipe.h"
#include "include/selecao.h"

#define NUM_TREINADORES 2
#define ARQUIVO_SAIDA "resultado.txt"

// Relogio do C11 (time.h) em segundos, com resolucao de nanossegundos.
static double tempo_atual(void) {
    struct timespec t;
    timespec_get(&t, TIME_UTC);
    return (double) t.tv_sec + (double) t.tv_nsec / 1e9;
}

// fprintf escreve tanto no terminal (stdout) quanto em um arquivo aberto.
static void escreve_pokemon(FILE* saida, Pokemon* p) {
    fprintf(saida, "ID: %d | Pokedex: %d | Nome: %s | Tipo: %s | Poder: %d | Energia: %d\n",
            p->id, p->num_pokedex, p->nome, p->tipo,
            pokemon_get_poder(p), pokemon_get_energia(p));
}

static void escreve_relatorio(FILE* saida, Pokemon* vetor[], int n,
                              int limite_energia, Equipe* melhor,
                              Treinador treinadores[], double segundos) {
    int quantidade = equipe_get_quantidade(melhor);
    fprintf(saida, "========================================\n");
    fprintf(saida, "======= RELATORIO DA SELECAO(Forca Bruta) =======\n");
    fprintf(saida, "========================================\n");
    fprintf(saida, "Pokemons disponiveis: %d\n", n);
    fprintf(saida, "Limite total de energia: %d\n", limite_energia);
    fprintf(saida, "Quantidade escolhida: %d\n", quantidade);
    fprintf(saida, "Poder total: %lld\n", equipe_get_poder_total(melhor));
    fprintf(saida, "Energia total: %lld\n", equipe_get_energia_total(melhor));
    fprintf(saida, "Tempo da selecao: %.9f segundos\n", segundos);
    fprintf(saida, "----------------------------------------\nPOKEMONS ESCOLHIDOS\n");
    if (quantidade == 0) {
        fprintf(saida, "A melhor equipe e vazia.\n");
    }
    for (int i = 0; i < quantidade; i++) {
        escreve_pokemon(saida, vetor[equipe_get_indice(melhor, i)]);
    }
    fprintf(saida, "----------------------------------------\n");
    fprintf(saida, "DISTRIBUICAO ENTRE OS TREINADORES\n");
    for (int i = 0; i < NUM_TREINADORES; i++) {
        Treinador* t = &treinadores[i];
        fprintf(saida, "Treinador(a) %s | Quantidade: %d\n", t->nome, t->lista.quantidade);
        for (Celula* c = t->lista.primeiro; c != NULL; c = c->prox) {
            escreve_pokemon(saida, c->item);
        }
        fprintf(saida, "Poder: %lld | Energia: %lld\n",
                treinador_get_poder_total(t), treinador_get_energia_total(t));
    }
    fprintf(saida, "Pokemons nao escolhidos: %d\n", n - quantidade);
    fprintf(saida, "========================================\n");
}

int main(int argc, char* argv[]) {
    if (argc < 2) {
        printf("Uso: %s testes/mini.txt\n", argv[0]);
        return 1;
    }
    // Leitura sequencial do arquivo de texto, no formato do enunciado.
    FILE* f = fopen(argv[1], "r");
    if (f == NULL) {
        fprintf(stderr, "Erro ao abrir o arquivo: %s\n", argv[1]);
        return 1;
    }

    PokeLista disponiveis;
    inicializa_lista(&disponiveis);
    Treinador treinadores[NUM_TREINADORES] = {0};
    Equipe melhor = {0};
    Pokemon** vetor = NULL;
    int status = 1;  // vira 0 so se tudo der certo
    char nome1[MAX_NOME_TREINADOR], nome2[MAX_NOME_TREINADOR];
    int n, limite_energia;

    // 1. Cabecalho: dois treinadores, N e limite de energia.
    if (fscanf(f, "%49s %49s %d %d", nome1, nome2, &n, &limite_energia) != 4) {
        fprintf(stderr, "Erro na leitura do cabecalho.\n");
        goto encerrar;
    }
    inicializa_treinador(&treinadores[0], 1, nome1);
    inicializa_treinador(&treinadores[1], 2, nome2);

    // 2. Os N Pokemon vao para a lista de disponiveis.
    for (int i = 0; i < n; i++) {
        int num, poder, energia;
        char nome[MAX_STR], tipo[MAX_STR];
        if (fscanf(f, "%d %49s %49s %d %d", &num, nome, tipo, &poder, &energia) != 5) {
            fprintf(stderr, "Erro na leitura do Pokemon %d.\n", i + 1);
            goto encerrar;
        }
        Pokemon* p = malloc(sizeof(Pokemon));
        if (p == NULL) {
            fprintf(stderr, "Erro ao alocar o Pokemon.\n");
            goto encerrar;
        }
        inicializa_pokemon(p, i + 1, num, nome, tipo, poder, energia);
        if (!insere_pokemon(&disponiveis, p)) {
            libera_pokemon(p);
            fprintf(stderr, "Erro ao inserir o Pokemon.\n");
            goto encerrar;
        }
    }

    // 3. Equipe vazia e vetor com os enderecos da lista (acesso por indice).
    if (!inicializa_equipe(&melhor, n)) {
        fprintf(stderr, "Erro ao preparar a equipe.\n");
        goto encerrar;
    }
    vetor = malloc((size_t) n * sizeof(Pokemon*));
    if (n > 0 && vetor == NULL) {
        fprintf(stderr, "Erro ao alocar o vetor.\n");
        goto encerrar;
    }
    lista_para_vetor(&disponiveis, vetor, n);

    // 4. Mede somente a selecao por forca bruta.
    double inicio = tempo_atual();
    int sucesso = seleciona_melhor_equipe(vetor, n, limite_energia, &melhor);
    double segundos = tempo_atual() - inicio;
    if (!sucesso) {
        fprintf(stderr, "Erro durante a selecao da equipe.\n");
        goto encerrar;
    }

    // 5. Distribui alternadamente: posicoes pares para o primeiro treinador.
    for (int i = 0; i < equipe_get_quantidade(&melhor); i++) {
        int id = pokemon_get_id(vetor[equipe_get_indice(&melhor, i)]);
        Pokemon* p = remove_pokemon(&disponiveis, id);
        if (!treinador_recebe_pokemon(&treinadores[i % NUM_TREINADORES], p)) {
            libera_pokemon(p);
            fprintf(stderr, "Erro ao entregar o Pokemon ao treinador.\n");
            goto encerrar;
        }
    }

    // 6. O mesmo relatorio vai para o terminal e para o arquivo.
    escreve_relatorio(stdout, vetor, n, limite_energia, &melhor, treinadores, segundos);
    FILE* saida = fopen(ARQUIVO_SAIDA, "w");
    if (saida == NULL) {
        fprintf(stderr, "Erro ao criar %s.\n", ARQUIVO_SAIDA);
        goto encerrar;
    }
    escreve_relatorio(saida, vetor, n, limite_energia, &melhor, treinadores, segundos);
    fclose(saida);
    status = 0;

encerrar:
    // Ponto unico de limpeza: cada erro acima pula direto para ca.
    fclose(f);
    free(vetor);
    libera_equipe(&melhor);
    libera_lista(&disponiveis);
    libera_treinador(&treinadores[0]);
    libera_treinador(&treinadores[1]);
    return status;
}
